{
  "expo": {
    "name": "Listana",
    "slug": "Listana",
    "version": "2.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "listana",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.listana.app",
      "infoPlist": {
        "NSCameraUsageDescription": "",
        "NSPhotoLibraryUsageDescription": "",
        "NSMicrophoneUsageDescription": "",
        "NSLocationWhenInUseUsageDescription": ""
      }
    },
    "android": {
      "package": "com.listana.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E1733",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F5F8",
          "dark": {
            "backgroundColor": "#0B0C10"
          }
        }
      ],
      "expo-font",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Resume",
              "label": "Listana · Reprendre",
              "description": "Tes œuvres en cours, en un coup d'œil",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "QuickAdd",
              "label": "Listana · Ajouter",
              "description": "Ajoute une œuvre en un appui, dans le bon média",
              "minWidth": "250dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal"
            },
            {
              "name": "Continue",
              "label": "Listana · Dernier en cours",
              "description": "La dernière œuvre en cours, prête à reprendre",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "router": {
        "staticRendering": true
      }
    },
    "extra": {
      "router": {
        "history": "hash"
      },
      "eas": {
        "projectId": "2ede7089-a917-4fd7-b231-849ea67665c2"
      }
    }
  }
}
